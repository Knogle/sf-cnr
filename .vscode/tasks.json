{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build-normal",
      //"type": "shell",
      "command": "${workspaceRoot}/pawno/pawncc.exe",
      "args": [
        "${file}",
        "-Dgamemodes",
        "-;+",
        "-(+",
        //"-d3"
      ],
      "linux": {
        "command": "python3",
        "args": ["${workspaceFolder}/tools/local.py", "build"]
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "isBackground": false,
      "presentation": {
        "reveal": "silent",
        "panel": "dedicated"
      },
      "problemMatcher": "$pawncc"
    }
  ]
}